# Copy this file to .streamlit/secrets.toml and fill in real values.
# On Streamlit Cloud, paste the same content into the app's "Secrets" settings box.

admin_password = "change_me"
app_base_url = "https://your-app-name.streamlit.app"
support_whatsapp_number = "9715xxxxxxx"      # international format, digits only

# No AI API key needed -- the technical assistant is a 100% free local
# search engine (modules/ai_assistant.py), it never calls any external AI service.

# No Google Cloud Console needed either -- files (Excel + PDF + metadata) are
# stored directly inside this same GitHub repository via a Personal Access
# Token, created at github.com/settings/tokens (classic token, "repo" scope).
github_token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
github_repo = "your-username/sharq-app"   # exact "owner/repo" of this repository
github_branch = "main"
